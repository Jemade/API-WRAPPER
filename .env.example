# ==============================================================================
# Production LLM API Gateway - Environment Configuration
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# Security & Secrets
# Master key or secret used for signing webhook payloads (HMAC-SHA256)
WEBHOOK_SECRET=your-webhook-secret-min-32-chars-change-me

# CORS: Comma-separated list of allowed origins, e.g. "https://app.example.com,http://localhost:3000"
CORS_ORIGINS=*

# Database Connection (Async SQLAlchemy URL)
# For local dev / production with PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/gateway
# For SQLite (e.g. testing): sqlite+aiosqlite:///./gateway.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gateway

# Redis Connection (Rate limiting and distributed state)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
# Default requests per minute per API key
RATE_LIMIT_PER_MINUTE=60
# Failure policy if Redis is unreachable: 'fail_open' (allow traffic, log warning) or 'fail_closed' (reject with 429)
RATE_LIMIT_REDIS_FAILURE_POLICY=fail_open

# Upstream LLM Provider API Keys
# At least one provider key is required for handling generation requests
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=https://api.anthropic.com/v1

# Upstream Timeout & Retry Configuration
UPSTREAM_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Webhook Delivery Configuration
WEBHOOK_TIMEOUT_SECONDS=10.0
WEBHOOK_MAX_RETRIES=3

# Payload Size Limit in Bytes (default: 2MB)
MAX_REQUEST_SIZE_BYTES=2097152

# Debug Logging (WARNING: do NOT enable in production - logs request content)
LOG_REQUEST_CONTENT=false
